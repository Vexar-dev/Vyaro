{
  "name": "@vayro/api",
  "version": "0.2.0",
  "private": true,
  "description": "VAYRO backend API — NestJS + Prisma + MySQL",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "dev:credit-wallet": "ts-node src/scripts/dev-credit-wallet.ts",
    "custody:generate-master-seed": "ts-node src/scripts/generate-master-seed.ts",
    "custody:verify-master-seed": "ts-node src/scripts/verify-master-seed.ts",
    "tatum:setup": "ts-node src/scripts/setup-tatum-provider.ts",
    "db:triggers": "prisma db execute --file prisma/sql/payout-identifiers-trigger.sql --schema prisma/schema.prisma",
    "create-admin": "ts-node prisma/create-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/throttler": "^5.2.0",
    "@noble/curves": "^1.4.2",
    "@noble/hashes": "^1.4.0",
    "@prisma/client": "^5.19.0",
    "@scure/bip32": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "argon2": "^0.40.3",
    "bech32": "^2.0.0",
    "bs58check": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.19.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "@types/multer": "^1.4.12"
  }
}
