# ── VAYRO — Environment Variables (example only, no real secrets) ──
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.

NODE_ENV=development

# ── Database ──
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=vayro
MYSQL_USER=vayro_app
MYSQL_PASSWORD=changeme_app_password
DATABASE_URL="mysql://vayro_app:changeme_app_password@localhost:3306/vayro"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── JWT / Sessions ──
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Encryption (provider credentials, 2FA secrets) ──
# Generate with: openssl rand -hex 32
# Production: replace with a KMS/Secrets-Manager-backed key — see EncryptionService.
ENCRYPTION_KEY=

# ── App ──
PORT=3000
APP_URL=http://localhost:3001
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
# Publicly reachable base URL of THIS API (no trailing slash) — used only to
# register the Tatum webhook URL (https://<this>/api/v1/webhooks/tatum).
# Must be a real, internet-reachable HTTPS URL in production (Tatum cannot
# reach localhost) — e.g. via a tunnel (ngrok/cloudflared) for local testing.
PUBLIC_API_BASE_URL=

# true  = new accounts are ACTIVE immediately (no email provider exists yet).
# false = accounts stay PENDING until a verification flow activates them (not built yet!).
AUTO_ACTIVATE_USERS=true
# Number of reverse-proxy hops in front of the API (1 behind nginx/Cloudflare). Leave empty if none.
TRUST_PROXY=

# ── Providers (Sham Cash / Syriatel / Tatum) ──
# Real credentials are NEVER put here — they're stored encrypted in the
# database via SecretsService.setCredential(providerId, key, value), keyed by
# the `providers.code` row (shamcash/syriatel/tatum). See
# docs/05_APIS_AND_PROVIDERS.txt for the exact credential keys each provider
# expects and how to set them. Required keys: shamcash → tsa_api_key, account_address, (pin optional);
# syriatel → tsa_api_key, gsm, pin_code; tatum → api_key, hmac_secret.

# ── Docker (docker compose up -d --build) ──
# المنفذ الذي يُنشر عليه الموقع على جهازك
HTTP_PORT=80
# دومين حقيقي => HTTPS تلقائي من Caddy (ثم اضبط COOKIE_SECURE=true و CORS_ORIGINS=https://دومينك). اتركه فارغاً للتجربة على http.
SITE_ADDRESS=:80
COOKIE_SECURE=false
# true = تجاوز فحص الأنواع عند بناء الواجهة (الكود لم يُبنَ من قبل). اجعله false بعد أن تتأكد أنه يمر.
SKIP_TYPECHECK=true
# المدير الأول (تُنشئه خدمة init تلقائياً إن ملأت هذه القيم؛ كلمة السر 14 حرفاً على الأقل)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_SHAMCASH=
